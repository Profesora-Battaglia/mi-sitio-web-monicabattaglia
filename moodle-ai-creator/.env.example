# ============================================================================
# MoodleAI Creator - Configuración de Variables de Entorno (.env.example)
# ============================================================================
# IMPORTANTE: Copiá este archivo como ".env" en esta misma carpeta.
# El archivo ".env" está bloqueado en .gitignore para que tus claves NUNCA
# se suban a GitHub ni queden expuestas en el código.

# 1. SERVIDOR
PORT=4000
PUBLIC_APP_URL=http://localhost:4000
SESSION_SECRET=cambia_este_secreto_por_una_frase_larga_y_segura_2026
DB_PATH=./data/moodleai.sqlite

# 2. INTELIGENCIA ARTIFICIAL (Google Gemini)
GEMINI_API_KEY=tu_clave_de_gemini_aqui
GEMINI_MODEL=gemini-3.8-flash

# 3. SUPABASE (Proyecto Nuevo Exclusivo para MoodleAI Creator)
SUPABASE_URL=https://tu-nuevo-proyecto-moodleai.supabase.co
SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_aqui

# 4. MERCADO PAGO (Soporta las 2 modalidades en Pesos Argentinos - ARS)
# Modalidad A: API Checkout Pro Dinámico (Token privado de producción o prueba)
MP_ACCESS_TOKEN=APP_USR-tu-access-token-de-mercadopago-aqui
MP_PUBLIC_KEY=APP_USR-tu-public-key-de-mercadopago-aqui

# Modalidad B: Links directos de Suscripción / Botón de Pago de Mercado Pago
MP_LINK_PLAN_PRO=https://www.mercadopago.com.ar/subscriptions/checkout?preapproval_plan_id=TU_ID_PLAN_PRO_25000
MP_LINK_PLAN_INSTITUCIONAL=https://www.mercadopago.com.ar/subscriptions/checkout?preapproval_plan_id=TU_ID_PLAN_INST_50000
